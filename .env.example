# LeanClaw Configuration
# Copy to .env and fill in values

# --- LLM Providers ---
# Anthropic Claude (API key or OAuth)
LEANCLAW_ANTHROPIC_API_KEY=
# GitHub Copilot (token or OAuth)
LEANCLAW_GITHUB_TOKEN=
# Default provider: "anthropic" or "copilot"
LEANCLAW_DEFAULT_PROVIDER=anthropic

# --- Gateway ---
LEANCLAW_GATEWAY_PORT=18789
LEANCLAW_GATEWAY_HOST=127.0.0.1
# Gateway API key for authentication
LEANCLAW_GATEWAY_API_KEY=

# --- Runtime ---
LEANCLAW_ASSISTANT_NAME=Andy
LEANCLAW_CONTAINER_IMAGE=leanclaw-agent:latest
LEANCLAW_CONTAINER_TIMEOUT=1800000
LEANCLAW_MAX_CONCURRENT_CONTAINERS=5
LEANCLAW_IDLE_TIMEOUT=1800000

# --- Heartbeat ---
LEANCLAW_HEARTBEAT_INTERVAL=60000
LEANCLAW_HEARTBEAT_SKIP_WHEN_BUSY=true

# --- Logging ---
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# Log format: "pretty" or "json" (json for enterprise pipelines)
LOG_FORMAT=pretty

# --- Timezone ---
TZ=
