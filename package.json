{
  "name": "leanclaw",
  "version": "0.1.0-alpha.1",
  "description": "High-efficiency, security-first AI assistant runtime built for fast local execution, low resource usage, and reliable automation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "leanclaw": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "openclaw",
    "ai-assistant",
    "llm",
    "local-ai",
    "automation",
    "gateway",
    "agent",
    "typescript"
  ],
  "homepage": "https://github.com/scottgl9/LeanClaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/scottgl9/LeanClaw.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js start",
    "dev": "tsx src/cli.ts start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run --pool=forks --no-file-parallelism",
    "test:watch": "vitest --pool=forks --no-file-parallelism",
    "e2e": "vitest run e2e/ --pool=forks --no-file-parallelism",
    "e2e:scorecard": "tsx e2e/scorecard.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "jiti": "^2.6.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
